                        end
                    else
                        comp.HealthFrame.Visible = false
                    end

                    -- Armorbar
                    if Toggles and Toggles.ESPArmor and Toggles.ESPArmor.Value then
                        local armorVal = 0
                        local be = char:FindFirstChild("BodyEffects")
                        if be and be:FindFirstChild("Armor") then
