local crosshairRotAngle = 0

-- Main Visuals Render Loop with Proper Toggle Off Reset
RunService.RenderStepped:Connect(function(dt)
    local char = getChar()

    -- 1. Self Style Override
    local selfMatEnabled   = Toggles.SelfMaterialToggle and Toggles.SelfMaterialToggle.Value
    local selfColorEnabled = Toggles.SelfColorToggle and Toggles.SelfColorToggle.Value
    local selfDecalsDis    = Toggles.SelfDisableDecals and Toggles.SelfDisableDecals.Value
    local selfTransActive  = (Options and Options.SelfTransSlider and Options.SelfTransSlider.Value < 100)

    if (selfMatEnabled or selfColorEnabled or selfDecalsDis or selfTransActive) and char then
        local selfTransVal = (Options and Options.SelfTransSlider and Options.SelfTransSlider.Value or 100) / 100
        local selfMatName  = Options and Options.SelfMaterialSelect and Options.SelfMaterialSelect.Value or "ForceField"
        local selfColor    = Options and Options.SelfColorPicker and Options.SelfColorPicker.Value or Color3.fromRGB(255, 255, 255)
        local enumMat      = Enum.Material[selfMatName] or Enum.Material.ForceField

        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("BasePart") and not obj:IsA("Tool") then
                if not originalSelfState[obj] then
                    originalSelfState[obj] = {
                        Material = obj.Material,
                        Color = obj.Color,
                        Transparency = obj.Transparency
                    }
                end
                if selfMatEnabled then obj.Material = enumMat end
                if selfColorEnabled then obj.Color = selfColor end
                if selfTransActive then obj.Transparency = 1 - selfTransVal end
            elseif obj:IsA("Decal") then
                if not originalSelfState[obj] then
                    originalSelfState[obj] = { Transparency = obj.Transparency }
                end
                if selfDecalsDis then obj.Transparency = 1 end
            end
        end
    else
        if next(originalSelfState) ~= nil then
            restoreSelfState()
        end
    end

    -- 2. Tool Style Override
    local toolMatEnabled   = Toggles.ToolMaterialToggle and Toggles.ToolMaterialToggle.Value
    local toolColorEnabled = Toggles.ToolColorToggle and Toggles.ToolColorToggle.Value
    local toolDecalsDis    = Toggles.ToolDisableDecals and Toggles.ToolDisableDecals.Value
    local toolTransActive  = (Options and Options.ToolTransSlider and Options.ToolTransSlider.Value < 100)

    local tool, _ = getCurrentTool()
    if (toolMatEnabled or toolColorEnabled or toolDecalsDis or toolTransActive) and tool then
        local toolTransVal  = (Options and Options.ToolTransSlider and Options.ToolTransSlider.Value or 100) / 100
        local toolMatName   = Options and Options.ToolMaterialSelect and Options.ToolMaterialSelect.Value or "Neon"
        local toolColor     = Options and Options.ToolColorPicker and Options.ToolColorPicker.Value or Color3.fromRGB(0, 0, 255)
        local enumMat       = Enum.Material[toolMatName] or Enum.Material.Neon

        for _, obj in ipairs(tool:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("MeshPart") then
                if not originalToolState[obj] then
                    originalToolState[obj] = {
                        Material = obj.Material,
                        Color = obj.Color,
                        Transparency = obj.Transparency
                    }
                end
                if toolMatEnabled then obj.Material = enumMat end
                if toolColorEnabled then obj.Color = toolColor end
                if toolTransActive then obj.Transparency = 1 - toolTransVal end
            elseif obj:IsA("Decal") then
                if not originalToolState[obj] then
                    originalToolState[obj] = { Transparency = obj.Transparency }
                end
                if toolDecalsDis then obj.Transparency = 1 end
            end
        end
    else
        if next(originalToolState) ~= nil then
            restoreToolState()
        end
    end

    -- 3. Artifact-Free Crosshair Engine
    if Toggles.CrosshairEnabled and Toggles.CrosshairEnabled.Value and hasDrawing then
        local viewport = camera.ViewportSize
        local center   = Vector2.new(viewport.X / 2, viewport.Y / 2)
        local mousePos = UserInputService:GetMouseLocation()
        local posType  = Options.CrosshairPositionSelect and Options.CrosshairPositionSelect.Value or "Center"
        local origin   = (posType == "Mouse") and mousePos or center

        local rotSpeed = (Options.CrosshairRotSpeedVal and Options.CrosshairRotSpeedVal.Value or 9) / 10
        crosshairRotAngle = (crosshairRotAngle + dt * rotSpeed * 360) % 360

        local rot      = math.rad(Options.CrosshairRot and Options.CrosshairRot.Value or 0) + math.rad(crosshairRotAngle)
        local offset   = Options.CrosshairOffsetVal and Options.CrosshairOffsetVal.Value or 5
        local length   = Options.CrosshairLengthVal and Options.CrosshairLengthVal.Value or 20
        local thick    = Options.CrosshairThicknessVal and Options.CrosshairThicknessVal.Value or 2
        local mainCol  = Options.CrosshairColor1 and Options.CrosshairColor1.Value or Color3.fromRGB(0, 85, 255)
        local drawOutline = Toggles.CrosshairOutline and Toggles.CrosshairOutline.Value
        local outlineCol  = Options.CrosshairOutlineColor and Options.CrosshairOutlineColor.Value or Color3.fromRGB(0, 0, 0)

        for i = 1, 4 do
            local angle = rot + (i - 1) * (math.pi / 2)
            local dir   = Vector2.new(math.cos(angle), math.sin(angle))
            local p1    = origin + dir * offset
            local p2    = p1 + dir * length

            if drawOutline then
                local ol = drawingOutlines[i]
                ol.Visible = true
                ol.From = p1
                ol.To = p2
                ol.Thickness = thick + 2
                ol.Color = outlineCol
            else
                if hasDrawing and drawingOutlines[i] then drawingOutlines[i].Visible = false end
            end

            local l = drawingLines[i]
            l.Visible = true
            l.From = p1
            l.To = p2
            l.Thickness = thick
            l.Color = mainCol
        end
    else
        if hasDrawing then
            for i = 1, 4 do
                if drawingLines[i] then drawingLines[i].Visible = false end
                if drawingOutlines[i] then drawingOutlines[i].Visible = false end
            end
        end
    end

    -- 4. Indicators Engine (Ammo Display)
    if Toggles.IndicatorAmmo and Toggles.IndicatorAmmo.Value then
        local offX = Options.IndicatorOffsetX and Options.IndicatorOffsetX.Value or 0
        local offY = Options.IndicatorOffsetY and Options.IndicatorOffsetY.Value or 25
        local col  = Options.IndicatorAmmoColor and Options.IndicatorAmmoColor.Value or Color3.fromRGB(150, 160, 255)
        local style= Options.IndicatorStyle and Options.IndicatorStyle.Value or "lower"

        local ammoVal = "0"
        if tool then
            local ammoObj = tool:FindFirstChild("Ammo") or tool:FindFirstChild("AmmoClient")
            if ammoObj then ammoVal = tostring(ammoObj.Value) end
        end

        local textStr = "ammo: " .. ammoVal
        if style == "upper" then
            textStr = string.upper(textStr)
        elseif style == "capitalized" then
            textStr = "Ammo: " .. ammoVal
        end

        local viewport = camera.ViewportSize
        indAmmoLabel.Visible = true
        indAmmoLabel.Text = textStr
        indAmmoLabel.TextColor3 = col
        indAmmoLabel.Position = UDim2.new(0, (viewport.X / 2) + offX - 50, 0, (viewport.Y / 2) + offY)
        indAmmoLabel.Size = UDim2.new(0, 100, 0, 20)
    else
        indAmmoLabel.Visible = false
    end
end)

