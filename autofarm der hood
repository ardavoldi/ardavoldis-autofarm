                local myRoot = getRoot()
                if not myRoot then return end

                if not target or not target.Character then
                    myRoot.CFrame = CFrame.new(myRoot.Position.X, skyHeight, myRoot.Position.Z)
                    currentStatus = "Waiting for target to spawn..."
                    return
                end

                local targetChar = target.Character
                local thum = targetChar:FindFirstChildOfClass("Humanoid")

                if not thum or thum.Health <= 0 then
                    myRoot.CFrame = CFrame.new(myRoot.Position.X, skyHeight, myRoot.Position.Z)
                    currentStatus = "Target dead! Waiting in sky for respawn..."
                    return
                end

                if hasForceField(targetChar) then
                    myRoot.CFrame = CFrame.new(myRoot.Position.X, skyHeight, myRoot.Position.Z)
                    currentStatus = "Target has ForceField! Waiting in sky..."
                    return
                end

                equipWeapon(selectedWeapon)
                local tool, handle = getCurrentTool()
                local downed = isPlayerDowned(target)

                if downed then
                    local bodyPart = getDownedBodyPart(targetChar)
                    if bodyPart then
                        myRoot.CFrame = CFrame.new(bodyPart.Position + Vector3.new(0, 2.5, 0))
                    end

                    currentStatus = "Target downed! Following body & stomping..."
                    if stompAfterKill then
                        executeStomp(target)
                        triggerTaunt(target.Name)
                    end
                    task.wait(0.05)
                else
                    local tr = targetChar:FindFirstChild("HumanoidRootPart") or getDownedBodyPart(targetChar)
                    if not tr then return end

                    if tpToTarget then
                        if orbitEnabled then
                            orbitAngle = orbitAngle + dt * orbitSpeed
                            local ox = math.cos(orbitAngle) * orbitRadius
                            local oz = math.sin(orbitAngle) * orbitRadius
                            myRoot.CFrame = CFrame.new(tr.Position + Vector3.new(ox, 1, oz), tr.Position)
                        elseif strafeEnabled then
                            local swave = math.sin(tick() * 6) * 6
                            myRoot.CFrame = CFrame.new(tr.Position + Vector3.new(swave, 1, 4), tr.Position)
                        else
                            myRoot.CFrame = tr.CFrame + Vector3.new(0, 0, 3)
                        end
                    end

                    local targetPart = targetChar:FindFirstChild(shootPart) or targetChar:FindFirstChild("Head") or tr
                    if tool and handle and targetPart then
                        fireShotAtTarget(tool, handle, targetPart, target)
                        currentStatus = string.format("Firing at target! HP: %.0f", thum.Health)
                    end
                    task.wait(shootDelay)
                end
            end)
        else
            if autoKillCon then autoKillCon:Disconnect(); autoKillCon = nil end
            currentStatus = "Stopped"
        end
    end
})

