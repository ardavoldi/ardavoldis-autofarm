-- Ammo & Reload Check
local function checkAndReload(tool)
    if not tool then return end
    updateRemotes()

    local ammo       = tool:FindFirstChild("Ammo")
    local ammoClient = tool:FindFirstChild("AmmoClient")
    local stats      = WEAPON_STATS[tool.Name] or { maxAmmo = 6 }
    local maxAmmo    = stats.maxAmmo

    local char = getChar()
    local be   = char and char:FindFirstChild("BodyEffects")
    local isReloading = be and be:FindFirstChild("Reload") and be.Reload.Value == true

    if (ammo and ammo.Value <= 0) or (ammoClient and ammoClient.Value <= 0) or isReloading then
        if MainRemoteEvent then
            MainRemoteEvent:FireServer("Reload", tool)
        end
        if ammo       then ammo.Value = maxAmmo end
        if ammoClient then ammoClient.Value = maxAmmo end
        if isReloading then be.Reload.Value = false end
    end
end

