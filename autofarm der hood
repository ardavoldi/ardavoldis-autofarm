-- Shooting Function
local function fireShotAtTarget(tool, handle, targetPart, targetPlayer)
    updateRemotes()
    if not tool or not handle or not targetPart then return end

    checkAndReload(tool)

    local muzzlePos = getMuzzlePos(tool, handle)
    local headPos   = targetPart.Position

    if resolverOffset ~= 0 then
        local rad = math.rad(resolverOffset)
        headPos = headPos + Vector3.new(math.cos(rad) * 2, 0, math.sin(rad) * 2)
    end

    local stats  = WEAPON_STATS[tool.Name] or { damage = 34, range = 250 }
    local range  = (tool:FindFirstChild("Range")  and tool.Range.Value)  or stats.range
    local damage = (tool:FindFirstChild("Damage") and tool.Damage.Value) or stats.damage

    if headLockCam then
        camera.CFrame = CFrame.new(camera.CFrame.Position, headPos)
    end

    if MainRemoteEvent then
        MainRemoteEvent:FireServer(
            "ShootGun",
            handle,
            muzzlePos,
            nil,
            targetPart,
            headPos,
            Vector3.new(0, 1, 0),
            range,
            damage
        )
    end

    local toolRE = tool:FindFirstChild("RemoteEvent")
    if toolRE then
        pcall(function() toolRE:FireServer(muzzlePos, headPos) end)
    end

    pcall(function() tool:Activate() end)

    local ammo = tool:FindFirstChild("Ammo")
    local ammoClient = tool:FindFirstChild("AmmoClient")
    if ammo then ammo.Value = stats.maxAmmo end
    if ammoClient then ammoClient.Value = stats.maxAmmo end
end

-- Stomp Function
local function executeStomp(targetPlayer)
    updateRemotes()
    if not MainRemoteEvent then return end
    local r  = getRoot()
    local bodyPart = targetPlayer and targetPlayer.Character and getDownedBodyPart(targetPlayer.Character)
    if not r or not bodyPart then return end

    r.CFrame = CFrame.new(bodyPart.Position + Vector3.new(0, 2.5, 0))
    task.wait(0.03)

    MainRemoteEvent:FireServer("Stomp")
    task.wait(0.04)
    MainRemoteEvent:FireServer("Stomp")
end

