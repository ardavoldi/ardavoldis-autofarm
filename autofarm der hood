-- Caching for restoring original state when toggles are turned OFF
local originalSelfState = {}
local originalToolState = {}

local function restoreSelfState()
    for obj, state in pairs(originalSelfState) do
        if obj and obj.Parent then
            if state.Material then obj.Material = state.Material end
            if state.Color then obj.Color = state.Color end
            if state.Transparency ~= nil then obj.Transparency = state.Transparency end
        end
    end
    originalSelfState = {}
end

local function restoreToolState()
    for obj, state in pairs(originalToolState) do
        if obj and obj.Parent then
            if state.Material then obj.Material = state.Material end
            if state.Color then obj.Color = state.Color end
            if state.Transparency ~= nil then obj.Transparency = state.Transparency end
        end
    end
    originalToolState = {}
end

