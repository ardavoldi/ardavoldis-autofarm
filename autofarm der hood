-- Main Render Loop for Wallhack ESP & Highlight Chams
RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local char = p.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")

            -- Chams Handler
            if char then
                local highlight = char:FindFirstChild("HvHChams")
                if Toggles and Toggles.ChamsEnabled and Toggles.ChamsEnabled.Value then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "HvHChams"
                        highlight.Parent = char
                    end
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.FillColor = Options and Options.ChamColor1 and Options.ChamColor1.Value or Color3.fromRGB(168, 85, 247)
                    highlight.OutlineColor = Options and Options.ChamColor2 and Options.ChamColor2.Value or Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = (Options and Options.ChamFillTrans and Options.ChamFillTrans.Value or 5) / 10
                    highlight.OutlineTransparency = (Options and Options.ChamOutlineTrans and Options.ChamOutlineTrans.Value or 0) / 10
                else
                    if highlight then highlight:Destroy() end
                end
            end

            -- 2D Wallhack ESP Handler
            if char and hrp and head and hum and hum.Health > 0 then
                if not playerESPComponents[p.Name] then
                    createESPComponents(p)
                end

                local comp = playerESPComponents[p.Name]
                local headPos = head.Position + Vector3.new(0, 0.8, 0)
                local feetPos = hrp.Position - Vector3.new(0, 3.2, 0)

                local headScreen, visHead = camera:WorldToViewportPoint(headPos)
                local feetScreen, visFeet = camera:WorldToViewportPoint(feetPos)

                if visHead or visFeet then
                    comp.Container.Visible = true

                    local boxHeight = math.abs(feetScreen.Y - headScreen.Y)
                    local boxWidth = boxHeight * 0.55
                    local posX = headScreen.X - boxWidth / 2
                    local posY = headScreen.Y

                    comp.Container.Position = UDim2.new(0, posX, 0, posY)
                    comp.Container.Size = UDim2.new(0, boxWidth, 0, boxHeight)

                    -- 2D Corner Box Render
                    local boxColor = Options and Options.BoxColor and Options.BoxColor.Value or Color3.fromRGB(255, 255, 255)
                    local cornerLen = math.clamp(boxWidth * 0.25, 4, 15)

                    if Toggles and Toggles.ESPBox and Toggles.ESPBox.Value then
                        for _, line in pairs(comp.Corners) do line.Visible = true; line.BackgroundColor3 = boxColor end
                        
                        -- Top-Left
                        comp.Corners.TL_H.Position = UDim2.new(0, 0, 0, 0)
                        comp.Corners.TL_H.Size = UDim2.new(0, cornerLen, 0, 2)
                        comp.Corners.TL_V.Position = UDim2.new(0, 0, 0, 0)
                        comp.Corners.TL_V.Size = UDim2.new(0, 2, 0, cornerLen)

                        -- Top-Right
                        comp.Corners.TR_H.Position = UDim2.new(1, -cornerLen, 0, 0)
                        comp.Corners.TR_H.Size = UDim2.new(0, cornerLen, 0, 2)
                        comp.Corners.TR_V.Position = UDim2.new(1, -2, 0, 0)
                        comp.Corners.TR_V.Size = UDim2.new(0, 2, 0, cornerLen)

                        -- Bottom-Left
                        comp.Corners.BL_H.Position = UDim2.new(0, 0, 1, -2)
                        comp.Corners.BL_H.Size = UDim2.new(0, cornerLen, 0, 2)
                        comp.Corners.BL_V.Position = UDim2.new(0, 0, 1, -cornerLen)
                        comp.Corners.BL_V.Size = UDim2.new(0, 2, 0, cornerLen)

                        -- Bottom-Right
                        comp.Corners.BR_H.Position = UDim2.new(1, -cornerLen, 1, -2)
                        comp.Corners.BR_H.Size = UDim2.new(0, cornerLen, 0, 2)
                        comp.Corners.BR_V.Position = UDim2.new(1, -2, 1, -cornerLen)
                        comp.Corners.BR_V.Size = UDim2.new(0, 2, 0, cornerLen)
                    else
                        for _, line in pairs(comp.Corners) do line.Visible = false end
                    end

                    -- Box Fill Inside
                    if Toggles and Toggles.ESPFill and Toggles.ESPFill.Value then
                        comp.FillBox.Visible = true
                        comp.FillBox.Size = UDim2.new(1, 0, 1, 0)
                        comp.FillBox.BackgroundColor3 = Options and Options.FillColor and Options.FillColor.Value or Color3.fromRGB(168, 85, 247)
                        comp.FillBox.BackgroundTransparency = 0.75
                    else
                        comp.FillBox.Visible = false
                    end

                    -- Name Label
                    if Toggles and Toggles.ESPName and Toggles.ESPName.Value then
                        comp.NameLabel.Visible = true
                        comp.NameLabel.Text = p.Name
                        comp.NameLabel.TextColor3 = Options and Options.NameColor and Options.NameColor.Value or Color3.fromRGB(168, 85, 247)
                        comp.NameLabel.Position = UDim2.new(0, 0, 0, -16)
                        comp.NameLabel.Size = UDim2.new(1, 0, 0, 14)
                    else
                        comp.NameLabel.Visible = false
                    end

                    -- Weapon Label
                    if Toggles and Toggles.ESPWeapon and Toggles.ESPWeapon.Value then
                        local tool = char:FindFirstChildOfClass("Tool")
                        comp.WeaponLabel.Visible = true
                        comp.WeaponLabel.Text = tool and tool.Name or "[Bare Hands]"
                        comp.WeaponLabel.TextColor3 = Options and Options.WeaponColor and Options.WeaponColor.Value or Color3.fromRGB(255, 255, 255)
                        comp.WeaponLabel.Position = UDim2.new(0, 0, 1, 2)
                        comp.WeaponLabel.Size = UDim2.new(1, 0, 0, 12)
                    else
                        comp.WeaponLabel.Visible = false
                    end

                    -- Distance Label
                    if Toggles and Toggles.ESPDistance and Toggles.ESPDistance.Value then
                        local myRoot = getRoot()
                        local dist = myRoot and math.floor((hrp.Position - myRoot.Position).Magnitude) or 0
                        comp.DistLabel.Visible = true
                        comp.DistLabel.Text = dist .. "m"
                        comp.DistLabel.TextColor3 = Options and Options.DistanceColor and Options.DistanceColor.Value or Color3.fromRGB(200, 200, 200)
                        comp.DistLabel.Position = UDim2.new(0, 0, 1, (Toggles and Toggles.ESPWeapon and Toggles.ESPWeapon.Value) and 14 or 2)
                        comp.DistLabel.Size = UDim2.new(1, 0, 0, 12)
                    else
                        comp.DistLabel.Visible = false
                    end

                    -- Healthbar
