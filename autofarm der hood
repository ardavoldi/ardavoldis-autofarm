    Morning   = { clock=7,   fogEnd=900, fogStart=0, ambient=Color3.fromRGB(100,110,130), bright=1.5 },
    Sunset    = { clock=19,  fogEnd=700, fogStart=0, ambient=Color3.fromRGB(200,100,60),  bright=1.8 },
    Night     = { clock=0,   fogEnd=400, fogStart=0, ambient=Color3.fromRGB(20,20,50),    bright=0.3 },
    Storm     = { clock=12,  fogEnd=180, fogStart=0, ambient=Color3.fromRGB(55,55,70),    bright=0.7 },
    Blizzard  = { clock=12,  fogEnd=80,  fogStart=0, ambient=Color3.fromRGB(210,225,255), bright=1.2 },
