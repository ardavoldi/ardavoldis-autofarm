-- ForceField & Body Tracking Helpers
local function hasForceField(char)
    if not char then return false end
    return char:FindFirstChildOfClass("ForceField") ~= nil 
        or char:FindFirstChild("ForceField") ~= nil
        or char:FindFirstChild("FF") ~= nil
end

local function getDownedBodyPart(targetChar)
    if not targetChar then return nil end
    return targetChar:FindFirstChild("UpperTorso")
        or targetChar:FindFirstChild("Torso")
        or targetChar:FindFirstChild("HumanoidRootPart")
        or targetChar:FindFirstChild("Head")
end

-- Remote Detection
local MainRemoteEvent = nil

local function updateRemotes()
    if RS:FindFirstChild("MainRemotes") and RS.MainRemotes:FindFirstChild("MainRemoteEvent") then
        MainRemoteEvent = RS.MainRemotes.MainRemoteEvent
    elseif RS:FindFirstChild("GameRemotes") and RS.GameRemotes:FindFirstChild("MainGameEvent") then
        MainRemoteEvent = RS.GameRemotes.MainGameEvent
    else
        MainRemoteEvent = RS:FindFirstChild("MainRemoteEvent", true) 
