                        end
                        comp.ArmorFrame.Visible = true
                        comp.ArmorFrame.Position = UDim2.new(0, -12, 0, 0)
                        comp.ArmorFrame.Size = UDim2.new(0, 4, 1, 0)

                        local armorPercent = armorVal / 100
                        comp.ArmorBar.Size = UDim2.new(1, 0, armorPercent, 0)
                        comp.ArmorBar.Position = UDim2.new(0, 0, 1 - armorPercent, 0)
                    else
                        comp.ArmorFrame.Visible = false
                    end
                else
                    comp.Container.Visible = false
                end
            else
                if playerESPComponents[p.Name] then
                    playerESPComponents[p.Name].Container.Visible = false
                end
            end
        end
    end
end)

