-- Inventory Weapons List
local function getInventoryWeapons()
    local list = {}
    for _, t in ipairs(player.Backpack:GetChildren()) do
        if t:IsA("Tool") then table.insert(list, t.Name) end
    end
    local c = getChar()
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then table.insert(list, t.Name) end
        end
    end
    if #list == 0 then list = {"(No weapon)"} end
    return list
end

-- Weapon Equip
local function equipWeapon(weaponName)
    local c = getChar()
    if c then
        local current = c:FindFirstChildOfClass("Tool")
        if current and (current.Name == weaponName or weaponName:find(current.Name, 1, true)) then
            return current
        end
    end
    local bp = player.Backpack:FindFirstChild(weaponName)
    if bp then
        local hum = getHum()
        if hum then hum:EquipTool(bp) end
        task.wait(0.05)
        return bp
    end
    if c then
        local tool = c:FindFirstChildOfClass("Tool")
        if tool then return tool end
    end
    return nil
end

local function getCurrentTool()
    local c = getChar(); if not c then return nil, nil end
    local tool = c:FindFirstChildOfClass("Tool")
    return tool, tool and tool:FindFirstChild("Handle")
end

local function getMuzzlePos(tool, handle)
    if not handle then return Vector3.zero end
    local default = tool:FindFirstChild("Default")
    if default then
        local mesh = default:FindFirstChild("Mesh")
        if mesh then
            local muzzle = mesh:FindFirstChild("Muzzle")
            if muzzle then return muzzle.WorldPosition end
        end
    end
    return handle.Position
end

-- Target Body Part
local function getTargetTargetPart()
    local target = Players:FindFirstChild(selectedTarget)
    if not target or not target.Character then return nil end
    return target.Character:FindFirstChild(shootPart)
        or target.Character:FindFirstChild("Head")
        or target.Character:FindFirstChild("HumanoidRootPart")
end

-- Check Downed / K.O Status
local function isPlayerDowned(p)
    if not p or not p.Character then return true end
    local hum = p.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return true end
    
    local be = p.Character:FindFirstChild("BodyEffects")
    if be then
        local ko = be:FindFirstChild("K.O") or be:FindFirstChild("KO") or be:FindFirstChild("KnockedOut")
        if ko and ko.Value == true then return true end
    end
    
    if hum.PlatformStand == true or hum.Health <= 15 then
        return true
    end
    return false
end

